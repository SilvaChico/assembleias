{
  "name": "assembleias-local",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "demo": "node --env-file-if-exists=.env server.mjs --demo",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
