# Copy to .env. Set distinct temporary mesa passwords (at least 12 characters).
# Imported only when each city has no stored credential; first sign-in requires replacement.
# Once initialized, changing/removing these values does not reset the database password.
# Nome de utilizador fixo: mesa. Estes valores nunca são enviados para o cliente.
LISBOA_ADMIN_PASSWORD=
PORTO_ADMIN_PASSWORD=

# Optional: import legacy room codes only during the first migration.
# Codes then live in the database; changing these values does not rotate saved codes.
# No new room codes are used by the interface; each proposal gets its own 4-character code.
LISBOA_ROOM_CODE=
PORTO_ROOM_CODE=

# Para sessões partilhadas entre instâncias (obrigatório na Vercel):
SESSION_SECRET=
# Criadas pelo Marketplace; usar apenas no servidor, nunca no cliente:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# REVIEW_DATA=1 carrega exemplos e identifica o modo de teste.

PORT=4173
APP_HOST=127.0.0.1
# Para testar em dispositivos na mesma rede, configurar ambos com o IP deste computador:
# APP_HOST=0.0.0.0
# APP_ORIGIN=http://192.168.1.10:4173
# HTTP não protege as palavras-passe em trânsito. Usar apenas rede local de teste.

# A aplicação persiste em .data/assembleias.sqlite; npm run demo usa .data/demo.sqlite.
# DATA_FILE=/caminho/privado/assembleias.sqlite
